# Copy to .env (never commit .env) and fill in.
PAPRIKA_EMAIL=you@example.com
PAPRIKA_PASSWORD=your-paprika-password
# Long random string; it becomes part of the connector URL. Generate with:
#   openssl rand -hex 24
PAPRIKA_URL_SECRET=
# Minutes between background syncs with Paprika (default 5).
PAPRIKA_SYNC_MINUTES=5
# Only needed for the optional Cloudflare Tunnel service in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=
